<div class="card">
  <h2><%= category.name %></h2>
  <p><%= category.description || 'No description' %></p>
  <div class="actions">
    <a href="/categories/<%= category.id %>/edit" class="btn btn-secondary">Edit Category</a>
    <a href="/items/new/<%= category.id %>" class="btn btn-success">Add New Item</a>
    <a href="/" class="btn btn-secondary">Back to Categories</a>
  </div>
</div>

<div class="card">
  <h3>Items in this Category</h3>
  <% if (items && items.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Brand</th>
          <th>SKU</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr>
            <td><strong><%= item.name %></strong></td>
            <td><%= item.brand || '-' %></td>
            <td><%= item.sku || '-' %></td>
            <td>$<%= parseFloat(item.price).toFixed(2) %></td>
            <td><%= item.quantity %></td>
            <td>
              <a href="/items/<%= item.id %>/edit" class="btn btn-secondary">Edit</a>
              <form action="/items/<%= item.id %>/delete" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p>No items in this category yet. <a href="/items/new/<%= category.id %>">Add your first item</a>.</p>
  <% } %>
</div>
