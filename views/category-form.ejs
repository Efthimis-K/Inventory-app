<% if (errors && errors.length > 0) { %>
  <div class="alert alert-error">
    <strong>Please fix the following errors:</strong>
    <ul>
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<div class="card">
  <h2><%= title %></h2>
  <form action="<%= category ? '/categories/' + category.id + '/edit' : '/categories/new' %>" method="POST">
    <div class="form-group">
      <label for="name">Category Name *</label>
      <input type="text" id="name" name="name" value="<%= category ? category.name : '' %>" required>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description"><%= category ? category.description || '' : '' %></textarea>
    </div>
    <div class="actions">
      <button type="submit" class="btn btn-primary"><%= category ? 'Update Category' : 'Create Category' %></button>
      <a href="<%= category ? '/categories/' + category.id : '/' %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
