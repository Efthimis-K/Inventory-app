<div class="card">
  <h2>Product Categories</h2>
  <% if (categories && categories.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(category => { %>
          <tr>
            <td><strong><%= category.name %></strong></td>
            <td><%= category.description || 'No description' %></td>
            <td>
              <a href="/categories/<%= category.id %>" class="btn btn-primary">View Items</a>
              <a href="/categories/<%= category.id %>/edit" class="btn btn-secondary">Edit</a>
              <form action="/categories/<%= category.id %>/delete" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this category?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p>No categories found. <a href="/categories/new">Create your first category</a>.</p>
  <% } %>
</div>
