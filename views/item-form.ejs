<% if (errors && errors.length > 0) { %>
  <div class="alert alert-error">
    <strong>Please fix the following errors:</strong>
    <ul>
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<div class="card">
  <h2><%= title %></h2>
  <form action="<%= item ? '/items/' + item.id + '/edit' : '/items/new/' + (category ? category.id : item.category_id) %>" method="POST">
    <div class="form-group">
      <label for="name">Item Name *</label>
      <input type="text" id="name" name="name" value="<%= item ? item.name : '' %>" required>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description"><%= item ? item.description || '' : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="price">Price ($) *</label>
      <input type="number" id="price" name="price" step="0.01" min="0" value="<%= item ? item.price : '' %>" required>
    </div>
    <div class="form-group">
      <label for="quantity">Quantity *</label>
      <input type="number" id="quantity" name="quantity" min="0" value="<%= item ? item.quantity : '' %>" required>
    </div>
    <div class="form-group">
      <label for="sku">SKU</label>
      <input type="text" id="sku" name="sku" value="<%= item ? item.sku || '' : '' %>">
    </div>
    <div class="form-group">
      <label for="brand">Brand</label>
      <input type="text" id="brand" name="brand" value="<%= item ? item.brand || '' : '' %>">
    </div>
    <% if (categories) { %>
      <div class="form-group">
        <label for="category_id">Category *</label>
        <select id="category_id" name="category_id" required>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= item && String(item.category_id) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
          <% }); %>
        </select>
      </div>
    <% } %>
    <div class="actions">
      <button type="submit" class="btn btn-primary"><%= item ? 'Update Item' : 'Create Item' %></button>
      <a href="<%= category ? '/categories/' + category.id : '/categories/' + (item ? item.category_id : '') %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
